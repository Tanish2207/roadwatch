# RoadWatch local configuration template — copy to .env and adjust.
# All inference stays on this machine.

# Path to local YOLO weights (best.pt). Leave empty to auto-discover in models/.
ROADWATCH_MODEL_PATH=

# Upload validation
ROADWATCH_MAX_UPLOAD_MB=512

# Inference defaults
ROADWATCH_DEFAULT_SAMPLE_RATE_FPS=1.0
ROADWATCH_DEFAULT_CONFIDENCE_THRESHOLD=0.4
ROADWATCH_DEFAULT_IMAGE_SIZE=640

# Frontend dev server origins allowed by CORS
ROADWATCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
