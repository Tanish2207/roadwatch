# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Secrets & local config ----
.env
.env.local

# ---- Node / frontend ----
node_modules/
roadwatch/frontend/dist/
*.tsbuildinfo

# ---- Runtime data: uploads, artifacts, databases, logs ----
roadwatch/data/uploads/*
roadwatch/data/processed/*
roadwatch/data/database/*
roadwatch/data/logs/*
!roadwatch/data/uploads/.gitkeep
!roadwatch/data/processed/.gitkeep
!roadwatch/data/database/.gitkeep
!roadwatch/data/logs/.gitkeep

# ---- Model weights — ignored by default; see the explicit demo allowlist below ----
*.pt
*.pth
*.onnx
*.engine

# ---- Training / prediction output (derived) ----
runs/
track_*/
yolo_*/

# ---- Demo/source footage stays local (project privacy stance) ----
*.mov
*.avi

# ---- Derived files ----
_brief_extracted.txt

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
.DS_Store
# Local one-off training environment
.train-venv/

# RoadWatch demo-finetuning artifacts (explicit allowlist)
!roadwatch/models/best.pt
!roadwatch/models/roadwatch-pothole-finetuned.pt
!roadwatch/runs/
!roadwatch/runs/**
# Keep run snapshots under models/; avoid duplicate checkpoints and copied dataset frames.
roadwatch/runs/**/weights/
roadwatch/runs/**/train_batch*.jpg
roadwatch/runs/**/val_batch*.jpg
